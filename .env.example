# ===================================================
# ChathuX Production Environment Configuration
# ===================================================

# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# MySQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=chathux_db

# Web Dashboard Configuration
PORT=3000
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
DASHBOARD_URL=http://localhost:3000

# AI Provider Configuration
# Supported providers: gemini, openai, fallback
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Bot Configuration & Customization
DEFAULT_PREFIX=!
DEFAULT_EMBED_COLOR=#7C3AED
NODE_ENV=development
